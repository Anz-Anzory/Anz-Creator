# =============================================================================
# Anz Video Publisher - Environment Variables
# =============================================================================
# Salin file ini menjadi .env dan isi dengan value yang sesuai
# cp .env.example .env

# API Key Google Gemini (WAJIB untuk fitur AI)
# Dapatkan di: https://makersuite.google.com/app/apikey
# Catatan: API Key bisa juga diinput via UI di halaman Settings
# GEMINI_API_KEY=AIzaSy...

# API Token Replicate (OPSIONAL - hanya untuk fitur Watermark Remover dengan AI Inpainting)
# Dapatkan di: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_...
