{
  "name": "anz-video-publisher",
  "version": "1.0.0",
  "description": "AI-powered video generator and publisher for social media with viral content optimization",
  "main": "main.js",
  "author": "Anzory",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:renderer\" \"wait-on http://localhost:5173 && npm run dev:main\"",
    "dev:main": "electron . --dev",
    "dev:renderer": "vite",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "electron-builder",
    "build:win": "npm run build:renderer && electron-builder --win",
    "build:mac": "npm run build:renderer && electron-builder --mac",
    "build:linux": "npm run build:renderer && electron-builder --linux",
    "dist": "npm run build",
    "setup:ffmpeg": "node scripts/setup-ffmpeg.js",
    "setup:ffmpeg:win": "node scripts/setup-ffmpeg.js",
    "setup:ffmpeg:mac": "node scripts/setup-ffmpeg.js",
    "setup:ffmpeg:linux": "node scripts/setup-ffmpeg.js",
    "verify:ffmpeg": "node scripts/check-ffmpeg.js",
    "postinstall": "electron-builder install-app-deps",
    "test": "jest",
    "lint": "eslint src --ext .js,.jsx",
    "lint:fix": "eslint src --ext .js,.jsx --fix",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@u4/opencv4nodejs": "^6.5.2",
    "axios": "^1.6.5",
    "date-fns": "^3.2.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.7",
    "fluent-ffmpeg": "^2.1.2",
    "fs-extra": "^11.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-router-dom": "^6.21.1",
    "tar": "^6.2.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "adm-zip": "^0.5.10",
    "concurrently": "^8.2.2",
    "electron": "^28.1.3",
    "electron-builder": "^24.9.1",
    "electron-devtools-installer": "^3.2.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "vite": "^5.0.11",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.anzory.video-publisher",
    "productName": "Anz Video Publisher",
    "copyright": "Copyright © 2024 Anzory",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist/**/*",
      "src/services/**/*",
      "src/main/**/*",
      "resources/ffmpeg/**/*",
      "node_modules/@u4/opencv4nodejs/**/*",
      "node_modules/fluent-ffmpeg/**/*",
      "node_modules/@google/generative-ai/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "**/*",
          "!*.zip",
          "!*.tar.xz"
        ]
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "resources/ffmpeg/**/*",
      "node_modules/@u4/opencv4nodejs/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "resources/icon.ico",
      "publisherName": "Anzory",
      "verifyUpdateCodeSignature": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "resources/icon.icns",
      "category": "public.app-category.video",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        },
        {
          "target": "rpm",
          "arch": ["x64"]
        }
      ],
      "icon": "resources/icon.png",
      "category": "AudioVideo",
      "maintainer": "Anzory",
      "vendor": "Anzory",
      "synopsis": "AI Video Publisher",
      "description": "AI-powered video generator for social media"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeaderIcon": "resources/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Anz Video Publisher",
      "include": "resources/installer.nsh"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "publish": {
      "provider": "github",
      "owner": "Anz-Anzory",
      "repo": "Anz-Video-Publisher",
      "releaseType": "release"
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "electron",
    "video",
    "ai",
    "ffmpeg",
    "social-media",
    "tiktok",
    "instagram",
    "youtube",
    "viral",
    "content-creator"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Anz-Anzory/Anz-Creator.git"
  },
  "bugs": {
    "url": "https://github.com/Anz-Anzory/Anz-Creator/issues"
  },
  "homepage": "https://github.com/Anz-Anzory/Anz-Creator#readme"
}
