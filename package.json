{
  "name": "Anz-Creator",
  "version": "1.0.0",
  "description": "AI-powered video generator and publisher for social media",
  "main": "main.js",
  "homepage": ".",
  "author": "Anzory",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:renderer\" \"wait-on http://localhost:5173 && npm run dev:main\"",
    "dev:main": "electron . --dev",
    "dev:renderer": "vite",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "electron-builder",
    "build:win": "npm run build:renderer && electron-builder --win",
    "build:mac": "npm run build:renderer && electron-builder --mac",
    "build:linux": "npm run build:renderer && electron-builder --linux",
    "setup:ffmpeg": "node scripts/setup-ffmpeg.js",
    "verify:ffmpeg": "node scripts/check-ffmpeg.js",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@u4/opencv4nodejs": "^6.5.2",
    "axios": "^1.6.5",
    "date-fns": "^3.2.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.7",
    "fluent-ffmpeg": "^2.1.2",
    "fs-extra": "^11.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-router-dom": "^6.21.1",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "adm-zip": "^0.5.10",
    "concurrently": "^8.2.2",
    "electron": "^28.1.3",
    "electron-builder": "^24.9.1",
    "tar": "^6.2.0",
    "vite": "^5.0.11",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.anzory.video-publisher",
    "productName": "Anz Video Publisher",
    "copyright": "Copyright © 2024 Anzory",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist/**/*",
      "src/**/*",
      "resources/ffmpeg/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/ffmpeg",
        "to": "ffmpeg",
        "filter": ["**/*", "!*.zip", "!*.tar.xz"]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "resources/ffmpeg/**/*",
      "node_modules/@u4/opencv4nodejs/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Anz Video Publisher"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "category": "public.app-category.video"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "category": "AudioVideo"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
