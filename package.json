{
  "name": "anz-video-publisher",
  "version": "1.1.0",
  "description": "Anz Video Publisher App",
  "main": "main.js",
  "author": "Anz-Anzory",
  "license": "MIT",

  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:renderer": "vite build",
    "build:electron": "electron-builder",
    "build:win": "npm run build:renderer && electron-builder --win",
    "build:mac": "npm run build:renderer && electron-builder --mac",
    "build:linux": "npm run build:renderer && electron-builder --linux",
    "preview": "vite preview",
    "setup:ffmpeg": "node scripts/setup-ffmpeg.js"
  },

  "dependencies": {
    "@u4/opencv4nodejs": "^6.5.3",
    "axios": "^1.6.7",
    "fluent-ffmpeg": "^2.1.3"
  },

  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.21"
  },

  "build": {
    "appId": "com.anz.videopublisher",
    "productName": "Anz Video Publisher",

    "directories": {
      "output": "release"
    },

    "files": [
      "dist/**/*",
      "main.js",
      "package.json",
      "node_modules/**/*"
    ],

    "extraResources": [
      {
        "from": "ffmpeg",
        "to": "ffmpeg",
        "filter": ["**/*"]
      }
    ],

    "artifactName": "${productName}-Setup-${version}.${ext}",

    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "icon.ico"
    },

    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },

    "mac": {
      "target": ["dmg"]
    },

    "linux": {
      "target": ["AppImage"]
    },

    "publish": {
      "provider": "github",
      "owner": "Anz-Anzory",
      "repo": "Anz-Creator",
      "releaseType": "release"
    }
  }
}
