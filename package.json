{
  "name": "anz-video-publisher",
  "version": "1.0.0",
  "description": "AI-powered video generator and publisher for social media",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:main": "electron . --dev",
    "dev:renderer": "vite",
    "build": "vite build && electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@u4/opencv4nodejs": "^6.5.2",
    "axios": "^1.6.5",
    "concurrently": "^8.2.2",
    "crypto": "^1.0.1",
    "date-fns": "^3.2.0",
    "electron-store": "^8.1.0",
    "fluent-ffmpeg": "^2.1.2",
    "fs-extra": "^11.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-router-dom": "^6.21.1",
    "zustand": "^4.4.7",
    "zustand-persist": "^1.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^28.1.3",
    "electron-builder": "^24.9.1",
    "vite": "^5.0.11"
  },
  "build": {
    "appId": "com.anzory.video-publisher",
    "productName": "Anz Video Publisher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/main/**/*",
      "src/services/**/*",
      "resources/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "resources/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "resources/icon.png"
    }
  }
}
